{
  "name": "@vsrepo/prisma7-adapter",
  "version": "2.0.0-dev",
  "description": "VSRepository adapter implementation backed by Prisma 7, translating every VSRepository operation into Prisma Client calls.",
  "homepage": "https://github.com/jaobrabo123/VSRepoPrisma7Adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaobrabo123/VSRepoPrisma7Adapter.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "oxlint --type-aware src/ test/",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:docs": "prettier --write \"docs/**/*.md\" \"./*.md\"",
    "format:docs:check": "prettier --check \"docs/**/*.md\" \"./*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "full-validation": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "prisma:generate": "bun run prisma:generate:postgres",
    "prisma:generate:postgres": "bunx prisma generate --config prisma/postgres/prisma.config.ts",
    "prisma:migrate": "bun run prisma:migrate:postgres",
    "prisma:migrate:postgres": "bunx prisma migrate dev --config prisma/postgres/prisma.config.ts"
  },
  "keywords": [
    "prisma",
    "prisma7",
    "repository",
    "orm",
    "typescript",
    "repository-pattern",
    "vsrepo",
    "vsrepository",
    "adapter"
  ],
  "author": {
    "email": "joaodev.azevedo@outlook.com",
    "url": "https://github.com/jaobrabo123",
    "name": "João Pedro Azevedo Freire Mecenas"
  },
  "bugs": {
    "email": "joaodev.azevedo@outlook.com",
    "url": "https://github.com/jaobrabo123/VSRepoPrisma7Adapter/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@prisma/client": "^7.10.0",
    "vsrepo": "^3.0.0-dev.1"
  },
  "dependencies": {
    "deepmerge": "^4.3.1"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pg": "^8.23.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
