{
  "name": "@vsrepo/prisma7-adapter",
  "version": "2.0.0-dev",
  "author": {
    "email": "joaodev.azevedo@outlook.com",
    "url": "https://github.com/jaobrabo123",
    "name": "João Pedro Azevedo Freire Mecenas"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VSRepository/VSRepoPrisma7Adapter.git"
  },
  "main": "./dist/index.js",
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-mssql": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pg": "^8.23.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@prisma/client": "^7.10.0",
    "vsrepo": "^3.0.0-dev.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "bugs": {
    "email": "joaodev.azevedo@outlook.com",
    "url": "https://github.com/VSRepository/VSRepoPrisma7Adapter/issues"
  },
  "description": "VSRepository adapter implementation backed by Prisma 7.",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md",
    "CHANGELOG.md"
  ],
  "homepage": "https://github.com/VSRepository/VSRepoPrisma7Adapter#readme",
  "keywords": [
    "prisma",
    "prisma7",
    "repository",
    "orm",
    "typescript",
    "repository-pattern",
    "vsrepo",
    "vsrepository",
    "adapter"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src/ test/",
    "lint:fix": "oxlint --fix src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:docs": "prettier --write \"docs/**/*.md\" \"./*.md\"",
    "format:docs:check": "prettier --check \"docs/**/*.md\" \"./*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:postgres": "vitest run --config vitest.integration.config.ts test/postgres",
    "test:integration:mysql": "vitest run --config vitest.integration.config.ts test/mysql",
    "test:integration:sqlite": "vitest run --config vitest.integration.config.ts test/sqlite",
    "test:integration:sqlserver": "vitest run --config vitest.integration.config.ts test/sqlserver",
    "test:integration:cockroachdb": "vitest run --config vitest.integration.config.ts test/cockroachdb",
    "full-validation": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "prisma:generate": "bun run prisma:generate:postgres && bun run prisma:generate:sqlserver && bun run prisma:generate:sqlite && bun run prisma:generate:mysql && bun run prisma:generate:cockroachdb",
    "prisma:generate:postgres": "bunx prisma generate --config prisma/postgres/prisma.config.ts",
    "prisma:generate:sqlserver": "bunx prisma generate --config prisma/sqlserver/prisma.config.ts",
    "prisma:generate:mysql": "bunx prisma generate --config prisma/mysql/prisma.config.ts",
    "prisma:generate:sqlite": "bunx prisma generate --config prisma/sqlite/prisma.config.ts",
    "prisma:generate:cockroachdb": "bunx prisma generate --config prisma/cockroachdb/prisma.config.ts",
    "prisma:migrate": "bun run prisma:migrate:postgres && bun run prisma:migrate:sqlserver && bun run prisma:migrate:sqlite && bun run prisma:migrate:mysql && bun run prisma:migrate:cockroachdb",
    "prisma:migrate:postgres": "bunx prisma migrate dev --config prisma/postgres/prisma.config.ts",
    "prisma:migrate:sqlserver": "bunx prisma migrate dev --config prisma/sqlserver/prisma.config.ts",
    "prisma:migrate:mysql": "bunx prisma migrate dev --config prisma/mysql/prisma.config.ts",
    "prisma:migrate:sqlite": "bunx prisma migrate dev --config prisma/sqlite/prisma.config.ts",
    "prisma:migrate:cockroachdb": "bunx prisma migrate dev --config prisma/cockroachdb/prisma.config.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
