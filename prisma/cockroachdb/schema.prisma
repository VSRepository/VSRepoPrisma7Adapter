generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "cockroachdb"
}

model User {
  id          Int      @id @default(sequence())
  email       String   @unique
  name        String?
  balance     Int      @default(0)
  bonusPoints Int?
  posts       Post[]
  address     Address?
}

model Address {
  id      Int    @id @default(sequence())
  street  String
  city    String
  country String
  user    User   @relation(fields: [userId], references: [id])
  userId  Int    @unique
}

model Post {
  id        Int      @id @default(sequence())
  title     String
  content   String?
  published Boolean  @default(false)
  price     Decimal? @db.Decimal(10, 2)
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  tags      Tag[]
}

model Tag {
  id    Int    @id @default(sequence())
  name  String @unique
  posts Post[]
}
